# Create a Meta System User access token with the WhatsApp permissions.
# Never put this token in frontend code or commit a real value.
WHATSAPP_ACCESS_TOKEN=replace_with_meta_system_user_token

# Phone Number ID for the selected sender number +1 555-313-6232
WHATSAPP_PHONE_NUMBER_ID=1458558957330570

# Use a currently supported Graph API version for your Meta app, e.g. vXX.0
WHATSAPP_GRAPH_API_VERSION=vXX.0

# Long random secret used to authorize the webpage's send endpoint
WHATSAPP_ADMIN_KEY=replace_with_a_long_random_secret
